# Required for Vercel demo authentication.
DEMO_EXAMINER_EMAIL=examiner@example.com
DEMO_EXAMINER_PASSWORD=replace-with-a-strong-demo-password
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters

# Required when running on Vercel with a private Blob store.
# Prefer connecting the store to the Vercel project so OIDC is used automatically.
# BLOB_READ_WRITE_TOKEN=your-private-blob-read-write-token

# Optional: Supabase authentication tokens remain supported by the API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional comma-separated origins when the frontend is hosted separately.
CORS_ALLOWED_ORIGINS=https://your-visionable-domain.vercel.app
